# =========================================================
# PRODUCTION — isi sesuai domain deploy
# =========================================================
# NEXT_PUBLIC_APP_URL=dummy

# Spotify OAuth (untuk user-based export — opsional)
# SPOTIFY_CLIENT_ID=dummy
# SPOTIFY_CLIENT_SECRET=dummy
# SPOTIFY_REDIRECT_URI=dummy/api/spotify/callback

# YouTube OAuth (untuk user-based export — opsional)
# YOUTUBE_CLIENT_ID=dummy
# YOUTUBE_CLIENT_SECRET=dummy
# YOUTUBE_REDIRECT_URI=dummy/api/youtube/callback

# Gemini NLG (Google AI Studio)
# GEMINI_API_KEY=dummy
# GEMINI_MODEL=dummy

# =========================================================
# PROJECT ACCOUNT — Spotify & YouTube (server-side export)
# Playlist dibuat oleh server menggunakan akun kalskripdas@gmail.com
# Dapatkan refresh_token via OAuth flow SATU KALI saja:
#   Spotify: scopes = playlist-modify-public playlist-modify-private
#   YouTube: scopes = https://www.googleapis.com/auth/youtube, access_type=offline, prompt=consent
# Simpan refresh_token di sini. Token tidak expire selama tidak dicabut user.
# =========================================================
# SPOTIFY_PROJECT_REFRESH_TOKEN=isi_refresh_token_dari_spotify_oauth
# YOUTUBE_PROJECT_REFRESH_TOKEN=isi_refresh_token_dari_google_oauth

# =========================================================
# LOCAL DEVELOPMENT (opsional override)
# =========================================================
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# SPOTIFY_REDIRECT_URI=http://localhost:3000/api/spotify/callback
# YOUTUBE_REDIRECT_URI=http://localhost:3000/api/youtube/callback
